# Copy to backend/.env and fill in. Never commit backend/.env.

# --- OpenAI (or any OpenAI-compatible gateway such as OpenRouter) ---
OPENAI_API_KEY=sk-...
# Empty = api.openai.com. For OpenRouter: https://openrouter.ai/api/v1 and prefix models with openai/
OPENAI_BASE_URL=
# Small, low-cost models. Both can be swapped without code changes.
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4.1-mini

# --- Pricing used for the per-answer cost estimate (USD per 1M tokens) ---
# gpt-4.1-mini list price at time of writing; update if you change LLM_MODEL.
PRICE_INPUT_PER_1M=0.40
PRICE_OUTPUT_PER_1M=1.60
PRICE_EMBEDDING_PER_1M=0.02

# --- Retrieval ---
TOP_K=5
RETRIEVAL_MODE=hybrid          # vector | bm25 | hybrid

# --- Guardrail ---
MAX_INPUT_CHARS=1000

# --- Server ---
FRONTEND_ORIGIN=http://localhost:5173
RATE_LIMIT_CHAT=10/minute

# --- Paths (relative to backend/) ---
CHROMA_DIR=chroma
CHUNKS_FILE=../data/processed/chunks.jsonl
BM25_FILE=data/bm25.pkl
